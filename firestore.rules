rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Removed listings are intentionally undiscoverable. Collection queries must
    // include a compatible status filter so Firestore can prove this condition.
    match /listings/{listingId} {
      allow get, list: if resource.data.status is string
        && resource.data.status != 'removed';
      allow create, update, delete: if false;
    }

    match /aggregates/{scopeId} {
      allow read: if true;
      allow write: if false;
    }

    // Mirror of the public OpenRTA registry (Junta de Andalucía). Only Cloud
    // Functions consume it (cross-check, license lookup) via the Admin SDK;
    // the map reads the aggregated officialCells/officialCellPins instead.
    // Closed to clients so nobody can page through 51k docs on our bill.
    match /officialVut/{recordId} {
      allow read, write: if false;
    }

    match /officialStats/{cityId} {
      allow read: if true;
      allow write: if false;
    }

    // Precomputed geohash-cell aggregates of the official registry: bubble
    // counts per zoom band, plus embedded pins at street-level precision.
    match /officialCells/{cellId} {
      allow read: if true;
      allow write: if false;
    }

    match /officialCellPins/{cellId} {
      allow read: if true;
      allow write: if false;
    }

    // Votes, rate-limit buckets, and every future internal collection are
    // server-only. Admin SDK writes from Cloud Functions bypass these rules.
    match /votes/{voteId} {
      allow read, write: if false;
    }

    match /rateLimits/{document=**} {
      allow read, write: if false;
    }

    // Photo review queue: uploaded, listed, and approved exclusively through
    // Cloud Functions. Approved photos surface as `photo` on the listing doc.
    match /listingPhotos/{photoId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
